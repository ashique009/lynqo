# ==============================================================================
# LYNQO ENVIRONMENT CONFIGURATION
# Production Deployment: Coolify VPS (or Render / Neon)
# ==============================================================================

# ------------------------------------------------------------------------------
# COOLIFY VPS ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------

# Django Secret Key (Generate a random 50+ character string)
SECRET_KEY=replace-with-your-django-secret-key

# Production mode (MUST be False in production)
DEBUG=False

# Allowed hosts (comma-separated, include your domain and Coolify server IP/subdomain)
ALLOWED_HOSTS=lynqoweb.website,www.lynqoweb.website,localhost,127.0.0.1

# PostgreSQL Configuration (Supplied automatically by Coolify or docker-compose)
POSTGRES_DB=lynqo_db
POSTGRES_USER=lynqo
POSTGRES_PASSWORD=replace-with-database-password
DATABASE_URL=

# Redis URL (Channels Layer & Cache)
REDIS_URL=

# Persistent Media Storage Directory (mapped to volume in Coolify)
MEDIA_ROOT=/app/media

# CORS and CSRF Allowed Origins
CORS_ALLOWED_ORIGINS=https://lynqoweb.website,https://www.lynqoweb.website
CSRF_TRUSTED_ORIGINS=https://lynqoweb.website,https://www.lynqoweb.website

# Frontend URL
FRONTEND_URL=https://lynqoweb.website

# Cloudinary (Optional if using local persistent volume on Coolify; mandatory on Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID) — Optional Push Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@lynqoweb.website
