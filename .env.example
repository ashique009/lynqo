# ==============================================================================
# LYNQO ENVIRONMENT CONFIGURATION
# Frontend: Vercel (https://lynqoweb.website)
# Backend: Render (https://<service-name>.onrender.com)
# Database: Neon PostgreSQL (https://neon.tech)
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (RENDER) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------

# Django Secret Key (Set in Render Dashboard)
SECRET_KEY=generate-a-strong-50-character-secret-key-here

# Production mode
DEBUG=False

# Allowed hosts on Render (comma-separated, includes .onrender.com and custom domain)
ALLOWED_HOSTS=lynqoweb.website,www.lynqoweb.website,.onrender.com

# Neon PostgreSQL Connection String (from Neon Console -> Connection details)
# Direct or Pooled connection with sslmode=require
# Example: postgresql://username:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or pooled: postgresql://username:password@ep-cool-flower-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require

# Persistent Cloudinary Media Storage (Mandatory on Render to persist profile pictures across redeploys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=https://lynqoweb.website,https://www.lynqoweb.website,https://lynqoweb.vercel.app

# Frontend URL
FRONTEND_URL=https://lynqoweb.website

# Optional: Redis Channel Layer (only needed if running multiple Render instances; otherwise in-memory layer is used)
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Web Push (VAPID) — optional push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mailto:admin@lynqoweb.website


# ------------------------------------------------------------------------------
# FRONTEND (VERCEL) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------

# Render Backend URL (Set in Vercel Project Settings -> Environment Variables)
# Example: https://lynqo-backend.onrender.com
# VITE_API_URL=https://<your-render-service>.onrender.com

# Optional WebSocket URL (automatically derived from VITE_API_URL if omitted)
# VITE_WS_URL=wss://<your-render-service>.onrender.com
